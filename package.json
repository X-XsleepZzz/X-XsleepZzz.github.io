{
  "name": "notes-personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify-production.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/dates.test.ts tests/article-history.test.ts tests/cms-history.test.ts tests/cms-config.test.mjs tests/font-subsets.test.mjs",
    "build:qa": "NOTES_QA=1 astro build --mode qa && node scripts/copy-qa-assets.mjs",
    "test:browser": "playwright test",
    "test:cms": "playwright test --config playwright.cms.config.ts",
    "test:cms:content": "node scripts/verify-cms-content.mjs",
    "test:dates:integration": "node scripts/verify-auto-dates.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "astro": "7.4.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "lighthouse": "13.5.0"
  }
}
