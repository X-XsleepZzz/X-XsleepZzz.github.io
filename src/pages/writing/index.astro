---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getPublishedWriting } from '../../lib/writing';
const articles = await getPublishedWriting();
---
<Base title="記事一覧" description="公開された記事の一覧。">
  <section aria-labelledby="archive-title" class="archive-section">
    <h1 id="archive-title" class="page-title">記事一覧</h1>
    <WritingList articles={articles} />
  </section>
</Base>
