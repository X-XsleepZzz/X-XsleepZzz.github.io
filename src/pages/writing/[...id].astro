---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleDate from '../../components/ArticleDate.astro';
import { getPublishedWriting } from '../../lib/writing';
export async function getStaticPaths() {
  return (await getPublishedWriting()).map(article => ({ params: { id: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'writing'> }
const { article } = Astro.props;
const { title, description, publishedAt, updatedAt, language } = article.data;
const { Content } = await render(article);
const english = language === 'en';
---
<Base title={title} description={description} language={language} article>
  <article>
    <header class="article-header">
      <a href="/writing/" class="article-back text-link">{english ? 'All articles' : '記事一覧に戻る'}</a>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <span>{english ? 'Published' : '公開'} <ArticleDate value={publishedAt} language={language} /></span>
        {updatedAt && <span>{english ? 'Updated' : '更新'} <ArticleDate value={updatedAt} language={language} /></span>}
      </div>
      {description && <p class="article-description">{description}</p>}
    </header>
    <div class="prose"><Content /></div>
    <div class="article-end"><a class="text-link" href="/writing/">{english ? 'All articles' : '記事一覧に戻る'}</a></div>
  </article>
</Base>
