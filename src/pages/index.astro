---
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import { getPublishedWriting } from '../lib/writing';
const articles = await getPublishedWriting();
---
<Base>
  <section aria-labelledby="home-title">
    <h1 id="home-title" class="page-title">最近の記事</h1>
    <WritingList articles={articles.slice(0, 5)} />
  </section>
</Base>
