---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/shippori-mincho/400.css';
import serifFont from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import uiFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/global.css';

interface Props { title?: string; description?: string; language?: 'ja' | 'en'; article?: boolean; noindex?: boolean }
const { title, description = '学習記録、技術記事、エッセイ。', language = 'ja', article = false, noindex = false } = Astro.props;
const isEnglish = language === 'en';
const isWriting = Astro.url.pathname.startsWith('/writing');
const isQa = process.env.NOTES_QA === '1' && import.meta.env.MODE === 'qa';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title ?? '個人サイト';
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {article && <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />}
    {article && <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />}
    <script is:inline>
      (() => {
        let preference;
        try { preference = localStorage.getItem('notes-theme'); } catch {}
        document.documentElement.dataset.theme = preference === 'light' || preference === 'dark'
          ? preference : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'ja_JP'} />
    {(isQa || noindex) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : '本文へスキップ'}</a>
    {isQa && <div class="qa-notice">NOTES_QA_FIXTURE · 表示検証用の原稿です。本番には公開されません。</div>}
    <header class="site-header shell">
      <nav aria-label={isEnglish ? 'Main navigation' : 'メインナビゲーション'}>
        <a href="/" aria-current={!isWriting && Astro.url.pathname === '/' ? 'page' : undefined}>{isEnglish ? 'Home' : 'ホーム'}</a>
        <a href="/writing/" aria-current={isWriting ? 'page' : undefined}>{isEnglish ? 'Articles' : '記事一覧'}</a>
      </nav>
        <button hidden class="theme-toggle" type="button" aria-label={isEnglish ? 'Dark mode' : 'ダークモード'} aria-pressed="false" data-language={language}>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20.5 13.3A8.6 8.6 0 0 1 10.7 3.5a8.7 8.7 0 1 0 9.8 9.8Z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="3.6"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
        </button>
    </header>
    <main id="main" class:list={['shell', { 'article-main': article }]} tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <a href="#main" class="back-top">{isEnglish ? 'Back to top' : '先頭へ'}</a>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const media = matchMedia('(prefers-color-scheme: dark)');
      let manual: string | null = null;
      try { manual = localStorage.getItem('notes-theme'); } catch {}
      if (manual !== 'light' && manual !== 'dark') manual = null;
      function apply(theme: string) {
        document.documentElement.dataset.theme = theme;
        button?.setAttribute('aria-pressed', String(theme === 'dark'));
        if (button) button.title = button.dataset.language === 'en'
          ? (theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode')
          : (theme === 'dark' ? 'ライトモードに切り替える' : 'ダークモードに切り替える');
      }
      apply(document.documentElement.dataset.theme ?? 'light');
      if (button) {
        button.hidden = false;
        button.addEventListener('click', () => {
          manual = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          apply(manual);
          try { localStorage.setItem('notes-theme', manual); } catch {}
        });
      }
      media.addEventListener('change', () => { if (!manual) apply(media.matches ? 'dark' : 'light'); });
      window.addEventListener('storage', event => {
        if (event.key === 'notes-theme' || event.key === null) {
          manual = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : null;
          apply(manual ?? (media.matches ? 'dark' : 'light'));
        }
      });
    </script>
  </body>
</html>
