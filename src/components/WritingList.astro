---
import type { CollectionEntry } from 'astro:content';
import ArticleDate from './ArticleDate.astro';
interface Props { articles: CollectionEntry<'writing'>[] }
const { articles } = Astro.props;
---
{articles.length > 0 ? (
  <ol class="writing-list">
    {articles.map(article => (
      <li>
        <div class="entry-date"><ArticleDate value={article.data.publishedAt} language={article.data.language} /></div>
        <div class="entry-content" lang={article.data.language}>
          <h2><a href={`/writing/${article.id}/`}>{article.data.title}</a></h2>
          {article.data.description && <p>{article.data.description}</p>}
        </div>
      </li>
    ))}
  </ol>
) : (
  <div class="empty-state">
    <p>記事はまだありません。</p>
  </div>
)}
