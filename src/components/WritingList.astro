---
import type { CollectionEntry } from 'astro:content';
import ArticleDate from './ArticleDate.astro';
interface Props { articles: CollectionEntry<'writing'>[] }
const { articles } = Astro.props;
---
{articles.length > 0 ? (
  <ol class="writing-list">
    {articles.map(article => (
      <li>
        <div class="entry-date"><ArticleDate value={article.data.publishedAt} language={article.data.language} /></div>
        <div class="entry-content" lang={article.data.language}>
          <h3><a href={`/writing/${article.id}/`}>{article.data.title}<span aria-hidden="true" class="entry-arrow">↗</span></a></h3>
          {article.data.description && <p>{article.data.description}</p>}
          {article.data.category && <span class="entry-category" lang="en">{article.data.category}</span>}
        </div>
      </li>
    ))}
  </ol>
) : (
  <div class="empty-state">
    <p class="empty-title">記事は準備中です。</p>
    <p class="empty-description">公開された記事が、ここに並びます。</p>
  </div>
)}
